# WebSocket URL of the game server (also used to derive the HTTP API base for OAuth).
# The HTTP base is computed by stripping ws:// / wss:// and replacing with http:// / https://.
VITE_WS_URL=ws://localhost:8787

# Public Yandex OAuth client_id (the secret stays server-side; never put it here).
# Leave empty to hide the "Войти через Яндекс" button and run in guest-only mode.
VITE_YANDEX_CLIENT_ID=
